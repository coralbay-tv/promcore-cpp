@PACKAGE_INIT@
include(CMakeFindDependencyMacro)

set_and_check(promcore-cpp_INCLUDE_DIR "@PACKAGE_CMAKE_INSTALL_INCLUDEDIR@")

set(PROMCORE_CPP_USE_THIRDPARTY_LIBRARIES @USE_THIRDPARTY_LIBRARIES@)

set(CMAKE_THREAD_PREFER_PTHREAD TRUE)
find_dependency(Threads)
unset(CMAKE_THREAD_PREFER_PTHREAD)

include("${CMAKE_CURRENT_LIST_DIR}/promcore-cpp-targets.cmake")
